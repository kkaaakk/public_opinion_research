OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Langfuse v4 + OpenTelemetry. Disabled unless explicitly enabled with both keys.
# Configure the same values in API and Executor processes; never in Run inputs.
POR_TRACING_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
POR_TRACE_SAMPLE_RATE=1.0
POR_TRACE_TIMEOUT_SECONDS=2
POR_TRACE_SHUTDOWN_SECONDS=3

# LangSmith — independent opt-in LangChain business-service / RAG tracing.
# For metadata-only Langfuse operation, keep LangSmith disabled: its own native
# content upload policy is independent of the Langfuse egress filter.
# Tracing is opt-in: set LANGSMITH_TRACING=false (or leave unset) to run without it.
# Without an API key the app normalizes tracing off and runs normally.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=public-opinion-research
LANGSMITH_TRACING=false

# DeepSeek
DEEPSEEK_API_KEY=

# Volcengine Ark (OpenAI-compatible API)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Cheap/high-frequency auxiliary models
SUMMARIZATION_MODEL=volcengine:doubao-seed-2-0-mini-260428
RAG_QUERY_REWRITE_MODEL=volcengine:doubao-seed-2-0-mini-260428
ROLLING_COMPACTION_MODEL=volcengine:doubao-seed-2-0-mini-260428

# Core reasoning models
RESEARCH_MODEL=deepseek:deepseek-flash
COMPRESSION_MODEL=deepseek:deepseek-flash
FINAL_REPORT_MODEL=deepseek:deepseek-flash

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# Optional local enterprise-knowledge RAG configuration
RAG_ENABLED=true
RETRIEVAL_MODE=hybrid
RAG_KNOWLEDGE_BASE_PATHS=data/knowledge/public_opinion
RAG_TOP_K=4
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_RERANK_TOP_N=6
RAG_EMBEDDING_PROVIDER=hash
RAG_VECTORSTORE_PROVIDER=memory
RAG_RERANKER_PROVIDER=simple
RAG_JSON_TEXT_FIELDS=

# Rolling history compaction for SDK Agent invocations.
CONTEXT_COMPACTION_THRESHOLD_RATIO=0.75
RECENT_RAW_STEPS=3

# Optional Plugin + Skills assembly. Plugins only organize existing tools and
# SKILL.md guidance; load_skill still runs through the durable ToolExecutor.
# The default directory is the repository's plugins/ folder; override only when needed.
# PLUGINS_DIR=plugins
# Use an empty JSON list to disable all plugins: ENABLED_PLUGINS=[]
ENABLED_PLUGINS=["social-research"]

# Apify hosted MCP server for social platform collection.
# plugins/social-research/mcp.json reads this token through ${APIFY_TOKEN}; the
# server is skipped and its tools stay unavailable when the token is unset.
# The token is sent only as an MCP Authorization header; it is not written to
# prompts, logs or the durable role tool catalog.
APIFY_TOKEN=

# Bytebase DBHub MCP — database query tools (requires Node.js >= 22.5.0)
DBHUB_ENABLED=false
DBHUB_DSN=mysql://dbhub_readonly:password@localhost:3306/mydb
DBHUB_TRANSPORT=stdio
DBHUB_HTTP_PORT=8080

# Microsoft MarkItDown MCP — convert files to Markdown (official microsoft/markitdown)
MARKITDOWN_ENABLED=false

# Feishu/Lark Official MCP — 飞书/Lark API tools
FEISHU_ENABLED=false
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=
FEISHU_DOMAIN=https://open.feishu.cn
FEISHU_MCP_PRESET=preset.light
FEISHU_OAUTH_ENABLED=false

# Local Web UI / API security. The server binds to 127.0.0.1 by default.
# Set a strong token when using a reverse proxy or any non-local deployment.
HOST=127.0.0.1
PORT=8000
PUBLIC_OPINION_API_TOKEN=
