# Credentials and deployment connections only.
# Business models, feature switches, RAG, plugins and budgets live in config.yaml.
# Copy this file to .env and fill in the values you actually use.

# ---------------------------------------------------------------------------
# Model provider credentials
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Volcengine Ark (OpenAI-compatible API)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Research search and social collection
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
# Required by the enabled social-research plugin; disable the plugin in
# config.yaml instead if social collection is not wanted.
APIFY_TOKEN=

# ---------------------------------------------------------------------------
# PostgreSQL / DBOS execution
# ---------------------------------------------------------------------------
# Required by the CLI, Web API and Executor. Must use postgresql+psycopg.
DBOS_DATABASE_URL=
# Reuse an id only after the previous Executor process is dead.
DBOS_EXECUTOR_ID=
RUN_MAX_ACTIVE=4
RUN_OWNER_ACTIVE=2
RUN_QUEUE_CAPACITY=1000
RUN_APPROVAL_SECONDS=86400
RUN_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# Langfuse / OpenTelemetry (credentials only; tracing_enabled is in config.yaml)
# ---------------------------------------------------------------------------
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
POR_TRACE_SAMPLE_RATE=1.0
POR_TRACE_TIMEOUT_SECONDS=2
POR_TRACE_SHUTDOWN_SECONDS=3

# ---------------------------------------------------------------------------
# LangSmith (independent opt-in LangChain tracing)
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=public-opinion-research
LANGSMITH_TRACING=false

# ---------------------------------------------------------------------------
# Optional service credentials referenced by config.yaml
# ---------------------------------------------------------------------------
# DBHub DSN, used only when dbhub_enabled: true.
DBHUB_DSN=
# Feishu/Lark app secret, used only when feishu_enabled: true.
FEISHU_APP_SECRET=
# Milvus token, used only when rag_milvus_uri points at an authenticated server.
RAG_MILVUS_TOKEN=

# ---------------------------------------------------------------------------
# Web API (optional; the CLI does not use it)
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Required to expose the Web Run API; the CLI calls RunClient directly.
PUBLIC_OPINION_API_TOKEN=

# Open Agent Platform only.
SUPABASE_KEY=
SUPABASE_URL=
GET_API_KEYS_FROM_CONFIG=false
